# Fabric network defaults (2 orgs, Raft orderer, Fabric CA)
IMAGETAG="default"
CA_IMAGETAG="default"
MAX_RETRY=5
CLI_DELAY=3
CHANNEL_NAME="mychannel"
CC_SRC_LANGUAGE="go"
CC_VERSION="1.0.1"
CC_NAME="basic"
CC_SRC_PATH="../chaincode"
CC_SEQUENCE=auto
CC_INIT_FCN="NA"
# OR = one org peer can endorse (good for org-specific chaincode functions).
# Omit on deploy to use Fabric default (both orgs must endorse on a 2-org channel).
CC_END_POLICY="OR('Org1MSP.peer','Org2MSP.peer')"
CC_COLL_CONFIG="NA"
